{
  "name": "instarss-desktop",
  "productName": "InstaRSS",
  "version": "0.1.0",
  "description": "Public photo-sharing profiles as RSS feeds, synchronized from your desktop.",
  "author": "pk-dev-cs",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "node scripts/build.mjs && vite build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "velopack": "1.2.161"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.2.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.65.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
